<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/home.css">
    <link rel="stylesheet" href="/styles/SignUp.css">
    <title>Document</title>
</head>
<body>
    
     
    
    <section class="container-sm">

        <div id="main" class="main">

            <div class="horizontal-flex topbar">
                <div class=" logo-text "><strong>MakeLinks</strong></div>
                <div class="logo register-logo"> <img src="/assets/logo/ml.png" alt=""></div>
            </div>

            <div class="horizontal-flex center very-large-text   mt-2">

                <p>Start Your Professional Carrer</p>
            </div>

            <div class="vertical-flex" >
                <div class="input-container ">
                    <form action="/SignUp" method="post" class="vertical-flex-1 large-text ">
                        <label for="username" class="input-container-labels">Please enter your Email </label>
                        <input type="email" name="username" class="register-input input-placeholder">
                        <label for="password" class="input-container-labels">Password</label>
                        <input type="password" name="password" class="register-input input-placeholder">

                    
                    <div class="tandc horizontal-flex center">
                        <div style="width: 80%;" class="small-text">By clicking Agree & Join or Continue, you agree to the LinkedIn User <strong class="blue">Agreement</strong>, <strong class="blue">Privacy Policy</strong>, and <strong class="blue">Cookie Policy</strong>.
                        </div>
                    </div>
                    <div class="horizontal-flex center space-around" style="width: 100%;">
                        <button class="input-container-buttons" type="submit" ><strong>SignUp</strong></button>
                    </div>
                    </form>
                    <hr>
                    <div class="horizontal-flex center space-around">
                        <button class="input-container-google"><strong>
                            <div class="horizontal-flex center ">
                                <img src="/assets/icons/google.png" class="icon">
                                <p><a href="/auth/google" class="remove-ref-decoration">Continue With Google</a></p>
                            </div>
                        </strong></button>
                    </div>

                </div>
            </div>



        </div>



    </section>
    


    
</body>
<%- include('footer.ejs') %>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</html>

