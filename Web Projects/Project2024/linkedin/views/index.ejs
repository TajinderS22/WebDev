<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/style.css">
    <title>MakeLinks India</title>
</head>


<% if (locals.feed) { %>
 

<body class="container-fluid">
    <div id="navbar" class="container-fluid">
        <div class="navbar container-md" >
        <div class="navbar">
            <a class="remove-ref-decoration" href="/"><div class="logo"> <img  src="./assets/logo/ml.png" alt="MakeLinks logo"></div></a>
            <div>
                <form>
                    <input type="search" placeholder="Search...">
                    <button class="search-button" type="submit">Search</button>
                </form>
            </div>
        </div>
        <nav>
            <ul>
                <li><img class="icon" src="./assets/icons/home.png" ><p>Home</p></li>
                <li><img class="icon" src="./assets/icons/network.png" >
                    <p>My Network</p></li>
                <li>
                    <img src="./assets/icons/briefcase.png"  class="icon">
                    <p>jobs</p>
                </li>
                <li>
                    <img src="./assets/icons/messenger.png" class="icon">
                    <p>Messages</p>

                </li>
                <li>
                    <img src="./assets/icons/bell.png"  class="icon">
                    <p>Notifications</p>
                </li>
                <li>
                    <img style="border-radius: 50%;" src="https://res.cloudinary.com/dcpz5001o/image/upload/v1720769823/1682522354617_zy6n7c.jpg" class="icon">
                    <p>Me</p>
                </li>
                <li>
                    <img src="./assets/icons/diagram.png"  class="icon">
                    <p>For Business</p>
                </li>
                <li>
                    <img src="./assets/icons/square.png" class="icon">
                    <p>Try Premium</p>
                </li>
            </ul>
        </nav>
        </div>
    </div>
    <% if (locals.userdata) { %>
     
 
    <section class="content-holder container-md">
        <div class="section-1">
            <div class="user-data">
                <div  class="user-profile">
                    <div class="user-div-1">
                         <img  class="cover-image" src="./assets/images/cover.jpg" >
                        <% if (locals.userdata.image) { %>
                            <img  class="profile-image" src="<%= userdata.image %>"  >
                        <% } else{%>
                            <img  class="profile-image" src="https://res.cloudinary.com/dcpz5001o/image/upload/v1721200818/blank-profile-picture-973460_1280_afxv5q.png"  >

                        <% } %>
                    </div>
                </div>
                <div class="user-details">
                    <div><h5 class="username "><strong><%= userdata.name %></strong></h5></div>
                    <div><p class="user-designation"><%= userdata.designation %></p></div>
                    <div><p class="user-location" ><%= userdata.location %></p></div>
                    <div class="user-school">
                        <img style="width: 15px;
                        height:15px;
                         margin-right: 5px;" src="./assets/icons/user.png" alt="">
                        <strong>
                        <h5><%= userdata.school%></h5>
                        </strong>
                    </div>
                </div>
            </div>
            <div class="marketing">
                <p style="margin-top: 10px;" class="small-light-text">Network smarater with premium....</p>
                <div class="marketing-link">
                    <img class="icon" src="./assets/icons/square.png">

                    <p class="small-light-text" style="color: black;"><strong>Try premium for 30 days for Free</strong></p>
                </div>


            </div>
            <div class="user-analytics">
                <div >
                <p class="small-text"><strong>Profile views</strong></p>
                <p class="small-text" style="margin-bottom:5px ;" ><strong>View all Analytics</strong></p>
                <hr>
                <p class="small-text" style="margin-top: 10px;" ><strong>Saved Items </strong></p>
                <p class="small-text"><strong>Groups</strong></p>
                <p class="small-text"><strong>Events</strong></p>
                </div>
            </div>


        </div>
           <% } %>



        <div class="section-2">  
            
            <div class="make-post">
                <div class="horizontal-flex" style="width: 100%;">
                    <% if (locals.userdata.image) { %>
                            <img  class="profile-photo" src="<%= userdata.image %>"  >
                        <% } else{%>
                            <img  class="profile-photo" src="https://res.cloudinary.com/dcpz5001o/image/upload/v1721200818/blank-profile-picture-973460_1280_afxv5q.png"  >

                        <% } %>
                    <form style="width: 80%; border: none;" action="/makepost" method="post"><input id="post-input" type="text" name="post_text" placeholder="Start a post......  "> <button style="padding :10px; margin-left: 20px; border-radius: 10px; width: 15%; border: 1px solid rgb(183, 163, 249); background-color: rgb(168, 161, 255); " type="submit" >post</button></form>
    
    
                </div>
                <div class="horizontal-flex" style="justify-content: space-around;
                width: 95%;
                margin-bottom: 0px;">
                    <p><img src="./assets/icons/image-.png" class="icon"> <input style="opacity: 0; width:10px " type="file" name="uploadImage">Image  </p>
                    <p><img src="./assets/icons/calendar.png" class="icon"> Event </p>
                    <p><img src="./assets/icons/content-writing.png" class="icon"> Write Article </p>
                </div>
            </div>
            <hr style="margin: 20px;width: 100%;position: relative;left: -3.5%;">

            <%  feed.forEach( (post)=>{ %>  
            <div class="card">
                <div class="horizontal-flex">
                    <% if (locals) { %>
                        <img  class="profile-photo" src="<%= post.image %>"  >
                    <% } else{%>
                        <img  class="profile-photo" src="https://res.cloudinary.com/dcpz5001o/image/upload/v1721200818/blank-profile-picture-973460_1280_afxv5q.png"  >

                    <% } %>
                    <div class="post-user-data ">
                        <P><strong>   <%= post.name %>  </strong></P>
                        <P class="small-light-text" ><strong>  <%= post.skills %></strong></P>
                        <p class="small-light-text"> <%= post.post_time %></p>
                    </div>
                </div>
                <div class="post-content">
                    <p><%= post.post_text %></p>

                </div>
                <div class="post-photo">
                    <img src="<%= post.post_image %>" alt="">
                </div>
                <div class="horizontal-flex interactions  space-between">
                    <div class="horizontal-flex">
                        
                        <div class="horizontal-flex onclick">
                            <img src="./assets/icons/like.png"  class="icon">
                            <p style=" margin: 0px 0px 0px 5px;">like</p>
                        </div>

                    </div>
                    <div class="horizontal-flex">
                        <img class="icon" src="./assets/icons/messenger.png" >
                        <p style=" margin: 0px 0px 0px 5px;">comment</p>
                    </div>
                    <div class="horizontal-flex onclick">
                        <img class="icon" src="./assets/icons/refresh.png" >
                        <p style=" margin: 0px 0px 0px 5px;">repost</p>
                    </div>
                    <div class="horizontal-flex">
                        <img class="icon" src="./assets/icons/send.png" >
                        <p style=" margin: 0px 0px 0px 5px;">share</p>
                    </div>
                </div>

            </div>
            <% }) %>
            

        </div>
        <div class="section-3">
            
            <div class="news-section-1 text-big">
                <p><strong><h4 style="margin-bottom: 10px;">MakeLinks News</h4></strong></p>
                <p class="small-light-text" style="font-size: 1em;">
                    <strong>Top Stories</strong>
                </p>
            </div>
            <div class="news-articles vertical-flex">
                <div >
                    <div>
                        <strong>
                            Students rethink study abroad options
                        </strong>
                    </div>
                    <div class="small-light-text news-article-time"  >
                        time and view count
                    </div>
                </div>
                <div >
                    <div>
                        <strong>
                            Google is hiring 1000 new employees
                        </strong>
                    </div>
                    <div class="small-light-text news-article-time"  >
                        time and view count
                    </div>
                </div>
                <div >
                    <div>
                        <strong>
                            10 new opportinities for students
                        </strong>
                    </div>
                    <div class="small-light-text news-article-time"  >
                        time and view count
                    </div>
                </div>
                <div >
                    <div>
                        <strong>
                            web 3 On the rise, students should learn
                        </strong>
                    </div>
                    <div class="small-light-text news-article-time"  >
                        time and view count
                    </div>
                </div>
                <div >
                    <div>
                        <strong>
                            Government to provide free education
                        </strong>
                    </div>
                    <div class="small-light-text news-article-time"  >
                        time and view count
                    </div>
                </div>
                <div >
                    <div>
                        <strong>
                            New job opportunities in the market in the data science field
                        </strong>
                    </div>
                    <div class="small-light-text news-article-time"  >
                        time and view count
                    </div>
                </div>
            </div>
            
            
        </div>
    </section>

    
</body>

<% } %>

<script src="../public/javscript.js"></script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</html>