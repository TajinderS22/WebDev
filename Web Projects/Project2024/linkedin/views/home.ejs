<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="./styles/home.css">
    <title>MakeLinks</title>
</head>
<body>
    <section class="container-sm ">
        <div id="main">
            <div class="nav hosizontal-flex space-between ">

                <div class="horizontal-flex MakeLinks">
                    <div class="logo-text"><h4>MakeLinks</h4></div>
                    <div class="logo"> <img src="./assets/logo/ml.png" alt=""></div>
                </div>
                <div class="horizontal-flex container-1 space-between">
                    <div class="horizontal-flex space-between  links ">
                        <div class="vertical-flex link-width">
                            <img class="icon" src="./assets/icons/article.png" >
                            <span>Articles</span>
                        </div>
                        <div class="vertical-flex link-width">
                            <img src="./assets/icons/people.png" class="icon">
                            <span>People</span>
                        </div>
                        <div class="vertical-flex link-width">
                            <img src="./assets/icons/learning.png" class="icon">
                            <span>Learning</span>
                        </div>
                        <div class="vertical-flex link-width">
                            <img src="./assets/icons/briefcase.png" class="icon">
                            <span>Jobs</span>
                        </div>
                        <div class="vertical-flex link-width">
                            <img src="./assets/icons/games.png" class="icon">
                            <span>Games</span>
                        </div>
                    </div>
                    <div class="horizontal-flex space-between login-options">
                        <div class="light-text" >
                            <strong>
                                <a href="/login" class="remove-ref-decoration">Login</a>
                            </strong>
                        </div>
                        <div class="SignUp">
                            <strong><a href="/SignUp" class="remove-ref-decoration">SignUp</a></strong>
                        </div>
                    </div>
                </div>
                
            </div>

            <div class="horizontal-flex welcome-container">
               <div class="vertical-flex welcome space-between">
                    <div class="very-large-text welcome-text vertical-flex center">
                        <p>
                            Make connections with professionals in your field  .
                        </p>
                    </div>
                    <div class="vertical-flex google-container center space-between">
                        <div  class="login-buttons horizontal-flex center"> <img src="/assets/icons/google.png" class="icon" > <p>Continue With Google</p></div>
                        <div class="login-buttons horizontal-flex center" > <a href="/login" class="remove-ref-decoration"><p>Sign in with email</p></a> </div>
                    </div>
                    <div class="vertical-flex terms small-text">
                        <div><p>
                            By clicking Continue to join or sign in, you agree to MakeLinks User <span class="blue">Agreement</span>, <span class="blue">Privacy Policy</span>, and <span class="blue">Cookies Policy</span>.
                        </p></div>
                        <div >
                            <p class="large-text">
                                New to MakeLinks? <span class="blue"><a href="/SignUp" class="remove-ref-decoration-blue ">Join now</a></span>
                            </p>
                        </div>
                    </div>
               </div>
               <div class="welcome-image-container">
                <img class="welcome-image" src="/assets/images/welcomeimage.svg" alt="">
            
                </div>
            </div>
            <div>
                
            </div>

        </div>

    </section>
    


</body>
<%- include('footer.ejs') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

</html>